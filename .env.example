# ==============================================================================
# VenomLink Environment Configuration Example
# Copy to .env for local development, or inject via host/secret manager in prod.
# NEVER commit a real .env file or production credentials to version control.
# ==============================================================================

# --- Core Django Settings -----------------------------------------------------
# Production MUST set DEBUG=False. Local dev can use DEBUG=True.
DEBUG=True
# Required when DEBUG=False: minimum 50 random characters, no insecure placeholder.
# Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=replace-with-50-plus-char-cryptographically-random-secret-key
# Required when DEBUG=False: comma-separated hostnames (never '*').
ALLOWED_HOSTS=localhost,127.0.0.1
# Required in HTTPS deployments behind a reverse proxy:
# CSRF_TRUSTED_ORIGINS=https://venomlink.example.gov.ng

# --- PostgreSQL Database ------------------------------------------------------
# Production (DEBUG=False) REQUIRES PostgreSQL for SELECT FOR UPDATE row locks.
# DATABASE_URL=postgresql://venomlink:CHANGE_ME@127.0.0.1:5432/venomlink_db?sslmode=require
# DB_CONN_MAX_AGE=60
# DB_SSLMODE=prefer

# --- Cache & Rate Limiting ----------------------------------------------------
# Use 'db' in multi-worker production (run `python manage.py createcachetable`),
# or 'locmem' for single-process local development.
CACHE_BACKEND=locmem
THROTTLE_SEARCH_ANON=60/min
THROTTLE_PIN_AUTH=10/min
THROTTLE_USSD_SIMULATOR=60/min
# Set to number of trusted reverse proxies in front of VenomLink for IP throttling:
# NUM_PROXIES=1

# --- HTTPS & Cookie Security (automatically enforced when DEBUG=False) --------
# SECURE_SSL_REDIRECT defaults to True when DEBUG=False.
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
# Set True ONLY when VenomLink is behind a reverse proxy setting X-Forwarded-Proto:
TRUST_PROXY_SSL_HEADER=False
SESSION_COOKIE_AGE=28800
# Set only if CORS browser clients on another origin are explicitly required:
# CORS_ALLOWED_ORIGINS=https://portal.example.gov.ng

# --- Clinical & Operational Policy --------------------------------------------
CRITICAL_DAYS_OF_COVER_THRESHOLD=5.0
WARNING_DAYS_OF_COVER_THRESHOLD=7.0
# Planning assumption only (minimum vials per treatment readiness check; validate clinically):
MIN_TREATMENT_COURSE_VIALS=5
DEFAULT_RESUPPLY_LEAD_TIME_DAYS=3
DEFAULT_SAFETY_BUFFER_DAYS=2
STALE_DATA_THRESHOLD_HOURS=48
EXPIRY_WARNING_DAYS=60
MIN_CONSUMPTION_EVENTS_HIGH_CONFIDENCE=3
MIN_OBSERVATION_DAYS_HIGH_CONFIDENCE=7
USSD_SESSION_TIMEOUT_SECONDS=180
USSD_MAX_PIN_ATTEMPTS=3
USSD_LOCKOUT_MINUTES=15
LOG_LEVEL=INFO

# --- Demo / Pilot Controls ----------------------------------------------------
# Keep False in production/controlled pilot to disable /demo/, /api/ussd/simulate/,
# and unauthenticated SMS audit viewing.
DEMO_MODE=False

# --- Africa's Talking USSD / SMS Integration ----------------------------------
# Shared webhook secret verified via X-Gateway-Token or Authorization header:
# USSD_GATEWAY_TOKEN=replace-with-random-webhook-secret
# AT_USERNAME=sandbox
# AT_API_KEY=replace-with-africastalking-api-key
# AT_SENDER_ID=VenomLink
# AT_SMS_URL=https://api.sandbox.africastalking.com/version1/messaging
# AT_TIMEOUT_SECONDS=10

